FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_TENANT_KEY=replace_me
FDE_TENANT_ID=sixeat
FDE_OAUTH_REDIRECT_URI=https://fde.sixeat.icu/oauth/callback
# Keep 0 until real user-scoped OAuth/docx reading and Hermes are verified in the listener image.
FDE_ASSISTANT_INTAKE_ENABLED=0
# Keep 0 until the Card 2.0 form renders and submits with a real test account.
FDE_ASSISTANT_CARD_REVIEW_ENABLED=0
FDE_ASSISTANT_REVIEW_URL=https://fde.sixeat.icu/h5#meetings
# Optional 32-byte urlsafe-base64 key, generated locally and kept out of Git.
# FDE_USER_TOKEN_KEY=
FDE_PREBOUND_OPEN_ID_HASH=replace_with_sha256_of_bound_open_id
# Tenant default assistant for verified members. The actor must already exist and be active.
FDE_DEFAULT_ASSISTANT_ACTOR_ID=assistant-primary
# One-time capability grant for verified, automatically joined members only.
FDE_DEFAULT_MEMBER_CAPABILITIES=doc.read,task.write
FDE_MEETING_AGENT_ID=meeting-agent
# Optional user scopes, space separated. Keep this empty for basic login.
# For assistant docx intake, first approve user-identity docx:document:readonly and then request it here.
FDE_OAUTH_SCOPES=
