ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

RUN pip install --no-cache-dir --timeout 60 --retries 2 \
    --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    "fastapi>=0.110" \
    "uvicorn>=0.29" \
    "lark-oapi>=1.7.3,<2"

COPY src ./src
COPY scripts ./scripts

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

CMD ["uvicorn", "scripts.fde_oauth_server:app", "--host", "0.0.0.0", "--port", "8210"]
